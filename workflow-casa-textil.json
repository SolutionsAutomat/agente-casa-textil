      ]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "binaryData": true,
        "binaryProperty": "data",
        "additionalFields": {
          "caption": "=🎬 Tu video está listo: {{$json.hashtags}}"
        }
      },
      "id": "tgvideo",
      "name": "Enviar video por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        740,
        500
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Bot Telegram Casa Textil"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=✅ Proceso completo.\nSúbelo a Buffer (Instagram + TikTok) o aprueba la publicación automática.\n\nDetalle del video:\n{{$json.hashtags}}"
      },
      "id": "tgfin",
      "name": "Aviso final",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        500
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Bot Telegram Casa Textil"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fs = require(\"fs\");\ntry {\n  const g = JSON.parse(fs.readFileSync(\"/opt/scripts/guion.json\", \"utf8\"));\n  const linea = new Date().toISOString() + \";\"\" + (g.tema || \"\") + \"\";\"\" + (g.hook || \"\") + \"\"\\n\";\n  fs.appendFileSync(\"/opt/scripts/historial.csv\", linea);\n} catch (e) {}\nreturn $input.all();"
      },
      "id": "hist",
      "name": "Registrar en historial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        500
      ]
    }
